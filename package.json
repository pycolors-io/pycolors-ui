{
  "name": "@pycolors/ui",
  "version": "1.0.6",
  "description": "Production-ready UI primitives for modern SaaS apps (Radix + Tailwind-friendly).",
  "keywords": [
    "pycolors",
    "ui",
    "components",
    "radix",
    "tailwind",
    "saas",
    "design-system",
    "react"
  ],
  "license": "MIT",
  "author": "PyColors",
  "homepage": "https://pycolors.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/pycolors-io/pycolors-ui"
  },
  "bugs": {
    "url": "https://github.com/pycolors-io/pycolors-ui/issues"
  },
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm clean && pnpm build",
    "lint": "eslint . --max-warnings 0",
    "types:check": "tsc --noEmit",
    "verify": "pnpm lint && pnpm types:check && pnpm build",
    "generate:component": "turbo gen react-component",
    "release": "pnpm clean && pnpm build:ts && pnpm publish --access public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "lucide-react": ">=0.300.0"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}
