{
  "name": "@pycolors/ui",
  "version": "1.5.1",
  "description": "Production-ready UI primitives for modern SaaS apps (Radix + Tailwind-friendly).",
  "keywords": [
    "pycolors",
    "ui",
    "components",
    "radix",
    "tailwind",
    "saas",
    "design-system",
    "react"
  ],
  "license": "MIT",
  "author": "PyColors",
  "homepage": "https://pycolors.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/pycolors-io/pycolors-ui"
  },
  "bugs": {
    "url": "https://github.com/pycolors-io/pycolors-ui/issues"
  },
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "pnpm clean && pnpm build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --config vitest.config.ts",
    "types:check": "tsc --noEmit",
    "verify": "pnpm test && pnpm lint && pnpm types:check && pnpm build && pnpm build-storybook",
    "generate:component": "turbo gen react-component",
    "release": "pnpm clean && pnpm build && pnpm publish --access public"
  },
  "peerDependencies": {
    "lucide-react": ">=0.300.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@pycolors/eslint-config": "^1.0.5",
    "@pycolors/tokens": "workspace:^",
    "@pycolors/typescript-config": "^1.0.0",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "storybook": "^10.5.9",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vitest-axe": "1.0.0-pre.5"
  }
}
